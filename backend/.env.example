# SmartSwitch Reference Backend Environment Configuration Template
# Copy this file to .env for local development. Never commit .env with real secrets.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (SQLite file path or :memory:)
DATABASE_PATH=smartswitch.db

# Ed25519 Token Signing Keys (PKCS#8 PEM format, newlines replaced with \n for single-line env)
# Generated for local development testing only
TOKEN_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIKcuowvxIv4lvsFmn6hBeaVbzseeMGIgOyWZQRYr/19s\n-----END PRIVATE KEY-----"
TOKEN_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEALCJAYkUAoWCPmFFNHi9+STmEyvTimt96rF84uHhTfec=\n-----END PUBLIC KEY-----"

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:8083/mqtt

# Rate Limiting Settings
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_TOKEN_MAX=30
RATE_LIMIT_WINDOW_MS=900000
